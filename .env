# ModalSearcher environment for inference, tools, and RL.
# Fill deployment-specific values before use; keep real credentials private.
# Load from the repository root with: source .env

# Shared auxiliary models for tool processing and LLM-as-judge.
# Fill the selected registry with your own model endpoints and credentials.
export SYNTHESIS_MODEL_CONFIG="synthesis/models.json"
export SFT_QWEN_MODEL_ALIAS="multimodal_process"
export SUMMARIZE_FALLBACK_MODEL_ALIAS="gemini35flash_internal_azure"

# Serper: fill your own API key; the URLs below are official public endpoints.
export SERPER_API_KEY=""
export SERPER_SEARCH_URL="https://google.serper.dev/search"
export SERPER_IMAGES_URL="https://google.serper.dev/images"
export SERPER_LENS_URL="https://google.serper.dev/lens"

# Firecrawl: fill your own API key to enable the scraping fallback.
export FIRECRAWL_API_KEY=""

# Reader selection: leave ENHANCED_READER_URL empty to use Jina Reader.
# Set it to your Enhanced Reader endpoint to select that backend instead.
export ENHANCED_READER_URL=""
export JINA_READER_URL="https://r.jina.ai/"
# Fill this only when your Jina Reader service requires authentication.
export JINA_API_KEY=""

# OSS uploads: fill your own bucket, regional endpoint, and credentials.
export OSS_ACCESS_KEY_ID=""
export OSS_ACCESS_KEY_SECRET=""
export OSS_ENDPOINT=""
export OSS_BUCKET_NAME=""
# Optional custom public domain or CDN; otherwise the bucket URL is derived.
# export OSS_PUBLIC_BASE_URL=""

# Agent model API: fill these when using API-based inference.
# For a server without authentication, set AGENT_API_KEY="EMPTY".
export AGENT_BASE_URL=""
export AGENT_MODEL_NAME=""
export AGENT_API_KEY=""

# RL reward judge: fill your own OpenAI-compatible endpoint, key, and model.
# Offline evaluation selects its judge alias from SYNTHESIS_MODEL_CONFIG.
export JUDGE_BASE_URL=""
export JUDGE_API_KEY=""
export JUDGE_MODEL=""

# Optional: used for search query similarity analysis; can be left unset.
export SEARCH_REDUNDANCY_EMBEDDING_URL=""
# Shadow mode records redundancy diagnostics without changing the reward.
export SEARCH_REDUNDANCY_MODE="shadow"

# Default image-download settings.
export SFT_IMAGE_DOWNLOAD_BACKEND="http"
export SFT_WIKIMEDIA_IMAGE_DOWNLOAD_BACKEND="http"
export SFT_WIKIMEDIA_THROTTLE="true"

# Log locally by default. Use online mode with your own W&B login if desired.
export WANDB_MODE="offline"
export WANDB_DIR="./outputs/wandb"
# export WANDB_API_KEY=""
export NCCL_DEBUG="WARN"
