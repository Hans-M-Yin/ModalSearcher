# Build with the repository root as the context. Keep source directories such
# as RL/rllm/rllm/data and RL/rllm/verl/verl/models in the image.

# Repository metadata and local assistant configuration.
**/.git
**/.release-private
**/.agents
**/.codex
**/.codex_artifacts
**/.aws
**/.ssh
**/.idea
**/.vscode

# Private credentials and deployment overrides. Public templates are retained.
**/.env*
!**/.env.example
**/*.env
**/.lark_env
**/models.local.json
**/models.*.local.json
**/*_keys.txt
**/firecrawl_keys.txt
**/.serper_pool_state.json*
**/firecrawl_state.json*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*

# User-provided datasets and model directories; framework source stays included.
/main.pdf
/images/*.png
!/images/logo.png
/data/
/models/
/SFT/data/
/opensearch_vl/data/
**/runs/
**/outputs/
**/checkpoints/
**/ckpts/
**/saves/
**/rollouts/
**/rollouts_saved/
**/wandb/
**/logs/
**/reader_workers/
**/reader_worker_pids/
**/remote_worker/
**/.cache/
**/.image_cache/
**/*.parquet
**/*.arrow
**/*.jsonl
**/*.jsonl.gz
**/*.pt
**/*.pth
**/*.bin
**/*.safetensors
**/*.ckpt
**/*.onnx
**/*.gguf
**/*.npy
**/*.npz
**/*.h5
**/*.hdf5
**/*.pkl
**/*.pickle
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.sqlite*

# Local environments, build products, caches, and temporary output.
**/.venv/
**/venv/
**/env/
**/ENV/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.eggs/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/build/
**/dist/
**/*.so
**/*.log
**/*.out
**/*.pid
**/*.tmp
**/*.bak
**/*.orig
**/*_log
**/*_timing_log
/watcher.log
/logs.txt
